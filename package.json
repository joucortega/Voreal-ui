{
  "name": "@voreal/ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "docs",
    "CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./avatar": "./src/components/avatar/index.ts",
    "./button": "./src/components/button/index.ts",
    "./content": "./src/components/content/index.ts",
    "./content/media-frame": "./src/components/content/media-frame.tsx",
    "./data": "./src/components/data/index.ts",
    "./data/static": "./src/components/data/static-data-table.tsx",
    "./feedback": "./src/components/feedback/index.ts",
    "./icons": "./src/icons/index.ts",
    "./form": "./src/components/form/index.ts",
    "./navigation": "./src/components/navigation/index.ts",
    "./overlay": "./src/components/overlay/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./patterns/admin": "./src/patterns/admin/index.ts",
    "./patterns/directory": "./src/patterns/directory/index.ts",
    "./patterns/directory/search-form": "./src/patterns/directory/search/directory-search-form.tsx",
    "./patterns/directory/search-suggestions": "./src/patterns/directory/search/directory-search-suggestions.tsx",
    "./patterns/directory/search-state": "./src/patterns/directory/search/directory-search-state.ts",
    "./styles.css": "./src/styles/index.css",
    "./next": "./src/next/index.ts",
    "./next/styles.css": "./src/next/styles.css",
    "./next/components/*": "./src/next/components/*/index.ts",
    "./next/patterns/directory": "./src/next/patterns/directory/index.ts",
    "./theme/neutral.css": "./src/themes/neutral.css",
    "./theme/mercado-nocturno.css": "./src/themes/mercado-nocturno.css",
    "./theme/red-latina.css": "./src/themes/red-latina.css",
    "./theme/admin.css": "./src/themes/admin.css"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "scripts": {
    "test": "vitest run --project unit && node --test scripts/*.test.mjs",
    "test:a11y": "vitest run --project a11y -t \"accessib|violations\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:e2e:next": "playwright test --config playwright.next.config.ts",
    "lint:css": "stylelint 'src/**/*.css'",
    "audit:css": "node scripts/audit-css.mjs",
    "audit:next-css": "node scripts/audit-next-css.mjs src/next",
    "budget:css": "node scripts/check-css-budget.mjs",
    "budget:search-css": "node scripts/check-css-budget.mjs src/patterns/directory/search/directory-search.css 3072",
    "budget:next-css": "node scripts/check-css-budget.mjs src/next 24576",
    "budget:next-directory-css": "node scripts/check-css-budget.mjs src/next/patterns/directory 8192"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@changesets/cli": "^3.0.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.7",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
